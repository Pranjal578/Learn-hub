# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/learnhub?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars_long

# Cloudinary Integration (Media & File Uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=LearnHub

# Nodemailer / SMTP Email Service
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password

# Razorpay Payment Gateway
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

# Frontend Application URL
# For production, set to your deployed frontend URL (e.g. https://yourdomain.com)
# Comma-separate multiple origins if needed
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting (all thresholds configurable) ───────────────
# Window duration in minutes for auth-related rate limits
RATE_LIMIT_AUTH_WINDOW_MIN=15
# Max login/signup attempts per IP per window
RATE_LIMIT_AUTH_MAX=10
# Max OTP send attempts per IP per window
RATE_LIMIT_OTP_MAX=5
# Max password-reset requests per IP per window
RATE_LIMIT_RESET_MAX=5
# Max requests per IP per 15 min on public (unauthenticated) endpoints
RATE_LIMIT_PUBLIC_MAX=100
# Max requests per IP per 15 min on authenticated endpoints
RATE_LIMIT_AUTHED_MAX=300

# ── File Upload Limits (MB) ───────────────────────────────────
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=500
